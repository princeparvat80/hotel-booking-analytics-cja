# ---------------------------------------------------------------------------
# TripNest — Adobe Web SDK configuration
# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values from Adobe.
#
# 1. Create the XDM schema "TripNest Booking ExperienceEvent" (see SCHEMA.md).
# 2. Create a Datastream with the "Adobe Analytics" service enabled, mapped to
#    your report suite (e.g. tripnest-analytics-dev). Optionally also enable the
#    "Adobe Experience Platform" service pointing at a dataset built on the
#    schema above, if you want the XDM to land in AEP directly as well.
# 3. Copy the Datastream ID (Edge config ID) and IMS Org ID below.
# 4. Set your XDM tenant ID (the "_yourtenant" prefix AEP adds to custom fields).
#
# Until DATASTREAM_ID/ORG_ID are set, the site still runs and pushes to
# window.adobeDataLayer, but Web SDK network calls are skipped (safe demo mode).
# ---------------------------------------------------------------------------

VITE_DATASTREAM_ID=your-datastream-id-here
VITE_ORG_ID=YOURORGID@AdobeOrg

# The XDM tenant prefix for custom fields, e.g. "_princeparvat".
# Placeholder until you confirm it from the schema.
VITE_XDM_TENANT=_tripnest

# Optional: first-party Edge domain (leave blank unless you have a CNAME)
# VITE_EDGE_DOMAIN=
